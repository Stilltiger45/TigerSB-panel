[Unit]
Description=TigerSB panel
Documentation=https://github.com/Stilltiger45/TigerSB-panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tigersb serve --config /etc/tigersb/config.json
Restart=on-failure
RestartSec=3s

# The panel only needs its config and database.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/tigersb
ReadOnlyPaths=/etc/tigersb
UMask=0077

[Install]
WantedBy=multi-user.target

[Unit]
Description=TigerSB update or rollback requested in the panel
Documentation=https://github.com/Stilltiger45/TigerSB-panel
After=network-online.target
Wants=network-online.target

# Started only by the panel (systemctl start --no-block), so there is no
# [Install] section. It runs in its own cgroup: the installer restarts the
# panel halfway through, and that must not stop the update itself.
[Service]
Type=oneshot
ExecStart=/usr/local/bin/tigersb job --config /etc/tigersb/config.json
TimeoutStartSec=30min
UMask=0077

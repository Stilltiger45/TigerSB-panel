[Unit]
Description=TigerSB Caddy (maintenance page, certificates)
Documentation=https://github.com/Stilltiger45/TigerSB-panel
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# The panel writes this file and loads changes over the admin socket, so a
# restart always comes back with the latest settings.
ExecStart=/usr/local/lib/tigersb/caddy run --config /var/lib/tigersb/caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/lib/tigersb/caddy reload --config /var/lib/tigersb/caddy/Caddyfile --adapter caddyfile --address unix//run/tigersb-caddy/admin.sock
Environment=XDG_DATA_HOME=/var/lib/tigersb/caddy XDG_CONFIG_HOME=/var/lib/tigersb/caddy
RuntimeDirectory=tigersb-caddy
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s
LimitNOFILE=1048576

# Caddy only needs to bind 80/443 and write its certificate storage.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/tigersb/caddy
ReadOnlyPaths=/var/lib/tigersb/www

[Install]
WantedBy=multi-user.target
